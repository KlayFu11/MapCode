provider = "deepseek"

[providers.openai]
protocol = "openai"
base_url = "https://www.right.codes/codex/v1"
model = "gpt-5.4"

[providers.anthropic]
protocol = "anthropic"
base_url = "https://www.right.codes/claude/v1"
model = "claude-sonnet-4-6"

[providers.deepseek]
protocol = "anthropic"
base_url = "https://api.deepseek.com/anthropic"
model = "deepseek-v4-pro"
# Optional provider-specific request budget. Confirm the model limit yourself.
# model_input_budget_tokens = 65536
# prompt_safety_margin_tokens = 2048

# Optional project-wide override. CLI budget flags take precedence.
[model_request_budget]
# model_input_budget_tokens = 32768
# prompt_safety_margin_tokens = 1024

[features]
map_engine = false

[sandbox]
mode = "off"
backend = "auto"
workspace_write = true
excluded_commands = []

[sandbox.filesystem]
extra_readonly_paths = []
deny_read = []
deny_write = []
